{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/sell", "destination": "/sell-your-property", "permanent": true },
    { "source": "/acquisitions", "destination": "/sell-your-property", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/((?!api/|assets/).*)", "destination": "/404.html" }
  ]
}
